<!DOCTYPE html>
<html class="h-full" lang="en">
  <head>
    <title><%%= [ content_for(:title), "Groundwork <%= provider_human %> MCP" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1f4bd8">
    <%%= csrf_meta_tags %>
    <%%= csp_meta_tag %>
    <%%= yield :head %>
    <link rel="icon" href="/groundwork-icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/groundwork-apple-touch-icon.png">
    <%%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%%= render "shared/cowork_tokens" %>
    <%%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div style="min-height: 100vh; display: flex; flex-direction: column;">
      <header style="position: sticky; top: 0; z-index: 50; background: var(--cw-paper); border-bottom: 1px solid var(--cw-line);">
        <div class="cw-wrap" style="height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 24px;">
          <div style="display: flex; align-items: center; gap: 24px; min-width: 0;">
            <%%= link_to main_app.root_path, style: "display: inline-flex; align-items: center; color: var(--cw-ink); text-decoration: none;" do %>
              <%%= render "shared/lockup" %>
            <%% end %>
            <%% if signed_in? %>
              <nav class="cw-nav-links">
                <%%= link_to "Setup", main_app.connections_path,
                      class: "cw-nav-link #{'cw-nav-link-active' if current_page?(main_app.connections_path)}" %>
                <%%= link_to "Tools", main_app.tools_path,
                      class: "cw-nav-link #{'cw-nav-link-active' if current_page?(main_app.tools_path)}" %>
              </nav>
            <%% end %>
          </div>
          <%% if signed_in? %>
            <div class="cw-nav-user">
              <span class="cw-nav-email" style="font-size: 13px; color: var(--cw-muted);"><%%= current_user.email %></span>
              <%%= button_to "Sign out", main_app.sign_out_path, method: :delete,
                    class: "cw-text-btn", form: { style: "display: inline;" } %>
            </div>
          <%% end %>
        </div>
      </header>

      <main class="cw-wrap" style="width: 100%; box-sizing: border-box; padding-top: 28px; padding-bottom: 64px; flex: 1;">
        <%%= render "shared/flash" %>
        <%%= yield %>
      </main>

      <footer style="border-top: 1px solid var(--cw-line); padding: 20px 0; font-size: 12px; color: var(--cw-muted);">
        <div class="cw-wrap" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
          <div>A Future Workshops service. &copy; <%%= Date.current.year %> Future Workshops Limited.</div>
          <div style="display: flex; gap: 18px; flex-wrap: wrap;">
            <%% if main_app.respond_to?(:privacy_path) %>
              <%%= link_to "Privacy", main_app.privacy_path, style: "color: inherit;" %>
              <%%= link_to "Terms", main_app.terms_path, style: "color: inherit;" %>
            <%% end %>
            <%%= link_to "Groundwork", AppConfig.groundwork_base_url, style: "color: inherit;" %>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
