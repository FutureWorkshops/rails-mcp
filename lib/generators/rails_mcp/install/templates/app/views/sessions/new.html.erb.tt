<%% content_for :title, "Sign in" %>

<div class="cw-card-page">
  <div class="cw-card">
    <h1>Sign in</h1>
    <div class="sub">Connect Claude to your <%= provider_human %> accounts. <em>Let's get to it.</em></div>

    <%%# Plain link, not Turbo: the SSO hop leaves this origin. %>
    <%%= link_to "Sign in with Groundwork", main_app.groundwork_connect_path,
          class: "cw-card-btn cw-card-btn-primary", data: { turbo: false } %>

    <div class="cw-card-note">
      Use your Groundwork account. You'll connect your <%= provider_human %> accounts after signing in.
    </div>
  </div>
</div>
